# Local Docker/PostgreSQL
POSTGRES_DB=customer_ops
POSTGRES_USER=customer_ops
POSTGRES_PASSWORD=change_me_local_only

# NVIDIA NIM (leave blank for deterministic fallback mode)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=z-ai/glm-5.3-flash
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_TIMEOUT_SECONDS=25
NVIDIA_NIM_MAX_RETRIES=2

# Airtable CRM adapter (mock/disabled by default)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_BASE_WEB_URL=
AIRTABLE_ENABLED=false
AIRTABLE_BASE_URL=https://api.airtable.com/v0
AIRTABLE_TIMEOUT_SECONDS=15
AIRTABLE_MAX_RETRIES=2
AIRTABLE_CUSTOMERS_TABLE=Customers
AIRTABLE_LEADS_TABLE=Leads
AIRTABLE_ACTIVITIES_TABLE=Activities
AIRTABLE_APPOINTMENTS_TABLE=Appointments
AIRTABLE_APPROVALS_TABLE=Approval Requests

APP_ENV=development
# Set for deployed environments. The local demo UI assumes this is blank.
ADMIN_API_KEY=
